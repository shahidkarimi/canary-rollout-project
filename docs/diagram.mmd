            ALIAS["alias live"]
            CDL["CodeDeploy canary<br/>10% / 5 min"]
            APIGW --> ALIAS --> FN
            CDL -.->|"shift / rollback"| ALIAS
        end
        subgraph EC2["EC2 target"]
            ALB["ALB :443 (HTTPS)<br/>weighted forward"]
            BLUE["blue TG :9898<br/>podinfo on host 1+2"]
            GREEN["green TG :9899<br/>podinfo on host 1+2"]
            CDE["CodeDeploy + hooks<br/>10% / 2 min weighted shift"]
            ALB -->|"90→0%"| BLUE
            ALB -->|"10→100%"| GREEN
            CDE -.->|"set weights"| ALB
        end
    end

    DEVGATE --> CDL
    DEVGATE --> CDE
    ECR -->|"pull by digest"| FN
    ECR -->|"pull by digest"| BLUE & GREEN

    subgraph OBS["observability & safety"]
        ALARMS["CloudWatch alarms<br/>fn errors · apigw 5xx · alb 5xx · p99 RT"]
        DASH["dashboard canary-rollout<br/>canary split · latency · errors · hosts"]
        SM["Secrets Manager<br/>/dockyard/SUPER_SECRET_TOKEN<br/>30-day rotation · log redaction"]
    end

    ALARMS -.->|"auto rollback"| CDL & CDE
