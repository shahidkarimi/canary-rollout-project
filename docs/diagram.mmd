flowchart TB
    subgraph GH["GitHub Actions (OIDC → AWS, no static keys)"]
        BUILD["build<br/>test podinfo @6.13.0 · buildx (pinned digests)<br/>cosign sign (keyless) · syft SBOM + attest"]
        DEVGATE["deploy dev<br/>policy gate: cosign verify digest"]
        APPROVE{{"prod environment<br/>human approval"}}
        PRODGATE["deploy prod<br/>same digest · policy gate again"]
        BUILD -->|"immutable digest"| DEVGATE --> APPROVE --> PRODGATE
    end

    ECR[("ECR canary/podinfo<br/>immutable tags · scan · KMS")]
    BUILD -->|push| ECR

    subgraph ENV["per environment (dev, then prod)"]
        direction TB
        subgraph LAMBDA["Lambda target"]
            APIGW["API GW HTTP API<br/>access logs + requestId"]
